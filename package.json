{
  "name": "heatwave-early-warning-root",
  "private": true,
  "version": "1.0.0",
  "description": "Heatwave Early Warning System - Root Workspace",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "dev:all": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:dev": "cd backend && python -m uvicorn app.main:app --reload --port 8000"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
